# ─── Database ─────────────────────────────────────────────────────────────────
# On the VPS this file is `.env.production`, read by docker-compose.yml.
# Values must NOT be quoted (the Dockerfile reads BUILD_DATABASE_URL with sed).
# Password for the pikorua-website-db container (generate: openssl rand -hex 24)
POSTGRES_PASSWORD=your_password
# Runtime: the app container reaches the db container by its service name.
DATABASE_URL=postgres://pikorua_app:your_password@db:5432/pikorua
# Build time: the image build runs on the host network and reaches the db
# through its loopback port.
BUILD_DATABASE_URL=postgres://pikorua_app:your_password@127.0.0.1:5433/pikorua
# Local development (npm run dev) instead uses a local Postgres, e.g.
# DATABASE_URL=postgres://pikorua_app:your_password@127.0.0.1:5432/pikorua

# ─── Media (uploads served by Nginx under /media) ────────────────────────────
# Set by docker-compose.yml in the container (/app/media, mounted from
# /var/www/pikorua-media). Only needed here for local development.
MEDIA_DIR=
NEXT_PUBLIC_MEDIA_BASE_URL=https://www.pikorua.in/media

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.pikorua.in
# Must be "true" in production — otherwise the holding page is shown.
NEXT_PUBLIC_SITE_LIVE=false
# Maya call agent (floating button, auto-popup, footer line). Paused; set to
# "true" and rebuild to show it again.
NEXT_PUBLIC_MAYA_ENABLED=false

# ─── Admin Console ────────────────────────────────────────────────────────────
ADMIN_EMAIL=your_admin_email@domain.com
ADMIN_PASSWORD=your_admin_password

# ─── In-house CRM lead feed (/api/crm/leads) ─────────────────────────────────
# Bearer token the CRM sends. Generate with: openssl rand -hex 32
CRM_API_KEY=

# ─── Optional features (each no-ops without its variable) ────────────────────
# Google Indexing API pings from admin actions
GOOGLE_SERVICE_ACCOUNT_JSON=
# Analytics
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_MICROSOFT_CLARITY_PROJECT_ID=xxxxxxxxxx
NEXT_PUBLIC_GTM_ID=
# Admin AI helpers (SEO / alt text generation) and the automated blog — leave
# empty to disable
OPENROUTER_API_KEY=
# IndexNow submissions on blog approval/publication. Must equal the name of the
# key file in public/ (public/<key>.txt containing the same key).
INDEX_NOW_KEY=

# ─── Automated blog (/api/cron/auto-blog, src/lib/ai/blogPipeline.ts) ──────────
# Bearer token the host crontab sends. Generate with: openssl rand -hex 32
CRON_SECRET=
# "true": nothing waits for approval — risky sentences (guaranteed returns,
# figures not in the source) are fixed or removed and the post goes live with
# topic disclaimers. Anything else saves every draft as pending review.
BLOG_AUTOPUBLISH=false
# OpenRouter model id (default google/gemini-2.5-flash)
BLOG_AI_MODEL=

# ─── SEO ──────────────────────────────────────────────────────────────────────
# "true" switches /p/ combo pages to strict matching (real budget/BHK filters,
# exact locations, intent pages noindexed). See docs/SEO_AEO_MASTER_PLAN.md §4.2.
SEO_COMBO_STRICT_MATCHING=false

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=916354359222                 # country code + number, no spaces
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE=Hi, I'd like to know more about luxury residences in Ahmedabad.

# ─── Sanity CMS (only if Studio / revalidation webhook is in use) ────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_WEBHOOK_SECRET=

# ─── Migration only (scripts/export-storage.ts) — remove after cutover ───────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
